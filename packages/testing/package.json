{
  "name": "@broadway-ts/testing",
  "version": "0.0.1",
  "type": "module",
  "description": "Testing helpers for Broadway TS.",
  "license": "MIT",
  "sideEffects": false,
  "keywords": [
    "testing",
    "event-sourcing",
    "cqrs",
    "typescript",
    "in-memory"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anders-planck/broadway-ts.git",
    "directory": "packages/testing"
  },
  "bugs": {
    "url": "https://github.com/Anders-planck/broadway-ts/issues"
  },
  "homepage": "https://github.com/Anders-planck/broadway-ts#readme",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@broadway-ts/core": ">=0.0.1",
    "@broadway-ts/event-sourcing": ">=0.0.1"
  },
  "devDependencies": {
    "@broadway-ts/core": "workspace:*",
    "@broadway-ts/event-sourcing": "workspace:*"
  }
}
