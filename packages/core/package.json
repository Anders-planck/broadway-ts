{
  "name": "@broadway-ts/core",
  "version": "0.0.1",
  "type": "module",
  "description": "Framework-agnostic CQRS core for Broadway TS.",
  "license": "MIT",
  "sideEffects": false,
  "keywords": [
    "cqrs",
    "typescript",
    "command-bus",
    "query-bus",
    "result"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anders-planck/broadway-ts.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Anders-planck/broadway-ts/issues"
  },
  "homepage": "https://github.com/Anders-planck/broadway-ts#readme",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
