{
  "name": "@broadway-ts/zod",
  "version": "0.0.1",
  "type": "module",
  "description": "Zod adapter for Broadway TS schemas.",
  "license": "MIT",
  "sideEffects": false,
  "keywords": [
    "zod",
    "validation",
    "cqrs",
    "typescript",
    "schema"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anders-planck/broadway-ts.git",
    "directory": "packages/zod"
  },
  "bugs": {
    "url": "https://github.com/Anders-planck/broadway-ts/issues"
  },
  "homepage": "https://github.com/Anders-planck/broadway-ts#readme",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@broadway-ts/core": ">=0.0.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@broadway-ts/core": "workspace:*",
    "zod": "^3.25.0"
  }
}
